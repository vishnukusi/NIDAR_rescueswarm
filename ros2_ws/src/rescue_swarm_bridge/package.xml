<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rescue_swarm_bridge</name>
  <version>1.0.0</version>
  <description>ROS 2 integration bridge and autonomy coordination package for NIDAR RescueSwarm 6-drone PX4 SITL + Gazebo simulation.</description>
  <maintainer email="dev@nidar-rescueswarm.org">NIDAR RescueSwarm Team</maintainer>
  <license>Proprietary</license>

  <!-- Build tool -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Core ROS 2 dependencies -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>builtin_interfaces</depend>

  <!-- Optional/recommended perception and flight interfaces -->
  <exec_depend>cv_bridge</exec_depend>

  <!-- Testing dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
